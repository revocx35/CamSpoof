{
  "name": "camspoof-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Frida agent that feeds CamSpoof's composited frames into a target app's camera.",
  "scripts": {
    "build": "frida-compile index.js -o ../app/src/main/assets/agent.js -c",
    "watch": "frida-compile index.js -o ../app/src/main/assets/agent.js -w"
  },
  "dependencies": {
    "frida-java-bridge": "7.0.13"
  },
  "devDependencies": {
    "frida-compile": "19.1.0"
  }
}
